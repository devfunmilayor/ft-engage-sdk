{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ft-engage.example/schemas/register.schema.json",
  "title": "Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["installId", "platform"],
  "properties": {
    "installId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "platform": { "enum": ["ios", "android", "web"] },
    "appVersion": { "type": "string", "maxLength": 32 },
    "sdkVersion": { "type": "string", "maxLength": 32 },
    "timezone": { "type": "string", "maxLength": 64 },
    "locale": { "type": "string", "maxLength": 16 },
    "pushStatus": { "enum": ["granted", "denied", "unknown"] },
    "pushToken": { "type": "string", "minLength": 20, "maxLength": 4096 }
  },
  "if": { "required": ["pushToken"], "properties": { "pushToken": true } },
  "then": { "required": ["pushStatus"], "properties": { "pushStatus": { "const": "granted" } } }
}
